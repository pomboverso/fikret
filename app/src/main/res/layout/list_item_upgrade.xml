<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/VerticalList"
    android:background="@color/surface_0"
    android:padding="8dp">

    <TextView
        android:id="@+id/upgrade_name"
        style="@style/H3"
        android:singleLine="true" />

    <TextView
        android:id="@+id/upgrade_stats"
        style="@style/Text"
        android:textColor="@color/disabled" />

    <View style="@style/SeparatorListVertical" />

    <LinearLayout style="@style/HorizontalList">

        <LinearLayout
            android:id="@+id/speed_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/accent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/base" />

            <TextView
                android:id="@+id/speed_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/base"
                android:textSize="@dimen/small" />
        </LinearLayout>

        <View style="@style/SeparatorListHorizontal" />

        <LinearLayout
            android:id="@+id/value_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/accent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/value_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/base" />

            <TextView
                android:id="@+id/value_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/base"
                android:textSize="@dimen/small" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
